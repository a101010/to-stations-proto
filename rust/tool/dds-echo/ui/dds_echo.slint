import { Button, LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct Frame {
    line: string,
    detail: string,
}

export struct Record {
    time: string,
    protocol: string,
    source: string,
    size: int,
    topic: string,
    submessages: string,
    hex: string,
    decoded: string,
    guid: string,
    entity: string,
    known: bool,
    frames: [Frame],
}

export struct RecordRow {
    time: string,
    protocol: string,
    source: string,
    size: int,
    topic: string,
    submessages: string,
    known: bool,
}

export struct TopicRow {
    name: string,
    known: bool,
    packets: int,
    selected: bool,
}

component StatChip inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 38px;
    min-width: 96px;
    background: #242424;
    border-radius: 6px;

    HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.value;
            color: #f0f0f0;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: #9a9a9a;
            vertical-alignment: center;
        }
    }
}

component TopicGroup inherits Rectangle {
    in property <string> title;
    in property <[TopicRow]> rows;
    in property <int> packets;
    in-out property <bool> expanded: true;
    callback toggle-row(string);
    callback topic-menu(length, length);

    background: transparent;

    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 26px;
            background: transparent;
            Text {
                x: 4px;
                vertical-alignment: center;
                text: root.expanded ? "v " + root.title + " (" + root.packets + ")" : "> " + root.title + " (" + root.packets + ")";
                color: #d0d0d0;
                font-weight: 600;
            }
            TouchArea {
                clicked => { root.expanded = !root.expanded; }
            }
        }
        if root.expanded : VerticalLayout {
            spacing: 1px;
            for row in root.rows : Rectangle {
                height: 20px;
                background: row.selected ? #3a4a5a : transparent;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 4px;
                    Text {
                        text: row.name;
                        color: row.known ? #8fd18f : #c9a26a;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "" + row.packets;
                        color: #9a9a9a;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.toggle-row(row.name);
                            return EventResult.accept;
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            root.topic-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "dds-echo";
    preferred-width: 1900px;
    preferred-height: 1040px;
    background: #1a1a1a;

    in-out property <bool> running: false;

    in-out property <int> packets: 0;
    in-out property <int> bytes: 0;
    in-out property <int> rtps: 0;
    in-out property <int> pps: 0;
    in-out property <int> bps: 0;
    in-out property <int> participants: 0;
    in-out property <int> endpoints: 0;
    in-out property <int> dropped: 0;
    in-out property <int> trimmed: 0;

    in-out property <string> iface: "StationsDDS";
    in-out property <string> group: "ff02::ffff:239.255.0.1";
    in-out property <string> ports: "7400, 7401";

    in-out property <[RecordRow]> records: [];
    in-out property <[TopicRow]> known-topics: [];
    in-out property <[TopicRow]> unknown-topics: [];
    in-out property <int> known-total: 0;
    in-out property <int> unknown-total: 0;

    // The records list's scroll position, for follow-the-tail.
    in-out property <length> list-content-y: 0px;
    out property <length> list-content-height: list.content-height;
    out property <length> list-visible-height: list.visible-height;

    in-out property <Record> selected: {
        time: "",
        protocol: "",
        source: "",
        size: 0,
        topic: "",
        submessages: "",
        hex: "",
        decoded: "",
        guid: "",
        entity: "",
        known: false,
        frames: [],
    };
    in-out property <int> selected-index: -1;
    in-out property <string> error-message: "";

    callback start();
    callback stop();
    callback clear();
    callback select(int);
    callback list-scrolled();
    callback dismiss-error();

    // Topic selection (the center filter) and its context menu.
    callback toggle-topic(string);
    callback clear-topics();
    callback topic-menu(length, length);
    callback dismiss-topic-menu();
    callback unselect-all-topics();

    in-out property <bool> topic-menu-visible: false;
    in-out property <length> topic-menu-x: 0px;
    in-out property <length> topic-menu-y: 0px;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // ---- toolbar ----
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Start"; enabled: !root.running; clicked => { root.start(); } }
            Button { text: "Stop"; enabled: root.running; clicked => { root.stop(); } }
            Button { text: "Clear"; clicked => { root.clear(); } }
            Rectangle { width: 12px; }
            Text { text: "iface"; color: #9a9a9a; vertical-alignment: center; }
            LineEdit { text: root.iface; read-only: root.running; min-width: 110px; }
            Text { text: "group"; color: #9a9a9a; vertical-alignment: center; }
            LineEdit { text: root.group; read-only: root.running; min-width: 210px; }
            Text { text: "ports"; color: #9a9a9a; vertical-alignment: center; }
            LineEdit { text: root.ports; read-only: root.running; min-width: 110px; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                background: root.running ? #1b4d24 : #333333;
                border-radius: 4px;
                min-width: 84px;
                Text {
                    text: root.running ? "Live" : "Stopped";
                    color: root.running ? #9ae6a0 : #b0b0b0;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // ---- stats ----
        HorizontalLayout {
            spacing: 8px;
            StatChip { label: "packets"; value: "" + root.packets; }
            StatChip { label: "bytes"; value: "" + root.bytes; }
            StatChip { label: "rtps"; value: "" + root.rtps; }
            StatChip { label: "dropped"; value: "" + root.dropped; }
            StatChip { label: "trimmed"; value: "" + root.trimmed; }
            StatChip { label: "pps"; value: "" + root.pps; }
            StatChip { label: "bps"; value: "" + root.bps; }
            StatChip { label: "participants"; value: "" + root.participants; }
            StatChip { label: "endpoints"; value: "" + root.endpoints; }
        }

        // ---- main ----
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // topics
            Rectangle {
                min-width: 240px;
                max-width: 240px;
                background: #202020;
                border-radius: 6px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Rectangle {
                        height: 20px;
                        background: transparent;
                        Text { text: "Topics (packets)"; color: #ffffff; font-weight: 700; vertical-alignment: center; }
                        TouchArea { clicked => { root.clear-topics(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            TopicGroup {
                                title: "Known"; rows: root.known-topics; packets: root.known-total;
                                toggle-row(name) => { root.toggle-topic(name); }
                                topic-menu(x, y) => { root.topic-menu(x, y); }
                            }
                            TopicGroup {
                                title: "Unknown"; rows: root.unknown-topics; packets: root.unknown-total;
                                toggle-row(name) => { root.toggle-topic(name); }
                                topic-menu(x, y) => { root.topic-menu(x, y); }
                            }
                        }
                    }
                }
            }

            // records
            Rectangle {
                horizontal-stretch: 1;
                background: #202020;
                border-radius: 6px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Time"; color: #9a9a9a; width: 70px; }
                        Text { text: "Protocol"; color: #9a9a9a; width: 80px; }
                        Text { text: "Source"; color: #9a9a9a; width: 300px; }
                        Text { text: "Topic"; color: #9a9a9a; width: 130px; }
                        Text { text: "Size"; color: #9a9a9a; width: 50px; }
                        Text { text: "Submessages"; color: #9a9a9a; horizontal-stretch: 1; }
                    }
                    list := ListView {
                        content-y <=> root.list-content-y;
                        scrolled => { root.list-scrolled(); }
                        vertical-stretch: 1;
                        for r[i] in root.records : Rectangle {
                            height: 22px;
                            background: i == root.selected-index ? #333a44 : transparent;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: r.time; color: #d0d0d0; width: 70px; vertical-alignment: center; }
                                Text { text: r.protocol; color: #9aa0b0; width: 80px; vertical-alignment: center; }
                                Text { text: r.source; color: #d0d0d0; width: 300px; vertical-alignment: center; }
                                Text { text: r.topic; color: r.known ? #8fd18f : #c9a26a; width: 130px; vertical-alignment: center; }
                                Text { text: "" + r.size; color: #d0d0d0; width: 50px; vertical-alignment: center; }
                                Text { text: r.submessages; color: #9a9a9a; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                            TouchArea {
                                clicked => { root.select(i); }
                            }
                        }
                    }
                }
            }

            // detail
            Rectangle {
                min-width: 361px;
                max-width: 361px;
                background: #202020;
                border-radius: 6px;
                ScrollView {
                    VerticalLayout {
                        alignment: LayoutAlignment.start;
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "Detail"; color: #ffffff; font-weight: 700; }
                        Text { text: "protocol: " + root.selected.protocol; color: #d0d0d0; }
                        Text { text: "source: " + root.selected.source; color: #d0d0d0; wrap: word-wrap; }
                        Text { text: "participant: " + root.selected.guid; color: #d0d0d0; }
                        Text { text: "writer: " + root.selected.entity; color: #d0d0d0; }
                        Text { text: "size: " + root.selected.size; color: #d0d0d0; }
                        Text { text: "topic: " + root.selected.topic; color: #d0d0d0; }
                        Rectangle { height: 6px; }
                        Text { text: "submessages (" + root.selected.frames.length + ")"; color: #9a9a9a; }
                        for f in root.selected.frames : VerticalLayout {
                            spacing: 1px;
                            Text { text: f.line; color: #d0d0d0; font-family: "Courier New"; font-size: 12px; wrap: word-wrap; }
                            if f.detail != "" : Text { text: f.detail; color: #8fd18f; font-size: 12px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: #3a3a3a; }
                        }
                        Rectangle { height: 6px; }
                        Text { text: root.selected.decoded != "" ? "decoded" : "hex"; color: #9a9a9a; }
                        Text {
                            text: root.selected.decoded != "" ? root.selected.decoded : root.selected.hex;
                            color: #c0c0c0;
                            font-family: "Courier New";
                            font-size: 12px;
                            wrap: no-wrap;
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }
    }

    // Topic-selection context menu (right-click in the topics pane).
    if root.topic-menu-visible : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        TouchArea {
            clicked => { root.dismiss-topic-menu(); }
        }
        Rectangle {
            x: min(root.topic-menu-x, parent.width - self.width);
            y: min(root.topic-menu-y, parent.height - self.height);
            width: 120px;
            height: 26px;
            background: #2f2f2f;
            border-radius: 4px;
            Text {
                text: "Unselect All";
                color: #e0e0e0;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                clicked => { root.unselect-all-topics(); }
            }
        }
    }

    if (root.error-message != "") : Rectangle {
        background: #000000b0;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px;
            height: 150px;
            background: #2a2a2a;
            border-radius: 8px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "Capture error"; color: #ff8080; font-weight: 700; }
                Text {
                    text: root.error-message;
                    color: #e0e0e0;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "OK"; clicked => { root.dismiss-error(); } }
                }
            }
        }
    }
}
