import { ComboBox } from "std-widgets.slint";

component Stick inherits Rectangle {
    in-out property <float> value-x: 0;
    in-out property <float> value-y: 0;
    in property <bool> interactive: true;
    callback drag(length, length, length);
    callback released();
    property <bool> dragging: false;
    property <length> knob-size: min(root.width, root.height) * 0.44;
    property <length> max-offset: max(0px, (root.width - root.knob-size) / 2 - 6px);

    background: #15171b;
    border-radius: min(self.width, self.height) / 2;
    border-width: 3px;
    border-color: #3a4048;

    Rectangle {
        width: root.knob-size;
        height: self.width;
        x: (parent.width - self.width) / 2 + root.value-x * root.max-offset;
        y: (parent.height - self.height) / 2 + root.value-y * root.max-offset;
        border-radius: self.width / 2;
        background: root.dragging ? #6fc2ff : #3a4048;
        border-width: 2px;
        border-color: root.dragging ? #a9dfff : #4b535d;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (!root.interactive) {
                return EventResult.reject;
            }
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.drag(
                    self.mouse-x - self.width / 2,
                    self.mouse-y - self.height / 2,
                    root.max-offset,
                );
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.move && root.dragging) {
                root.drag(
                    self.mouse-x - self.width / 2,
                    self.mouse-y - self.height / 2,
                    root.max-offset,
                );
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
                root.released();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

component ControllerButton inherits Rectangle {
    in property <string> label;
    in property <bool> down;
    callback pressed-changed(bool);

    width: 44px;
    height: 44px;
    border-radius: min(self.width, self.height) / 2;
    background: root.down ? #6fc2ff : #2e3339;
    border-width: 2px;
    border-color: root.down ? #a9dfff : #4b535d;

    Text {
        text: root.label;
        color: root.down ? #102030 : #e8edf2;
        font-size: min(root.width, root.height) * 0.38;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed-changed(true);
                return EventResult.accept;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.pressed-changed(false);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

export component MainWindow inherits Window {
    title: "paws";
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;
    background: #121417;

    in-out property <int> display-id: 0;
    in-out property <[string]> controllers: ["Virtual"];
    in-out property <int> controller-index: 0;
    in-out property <bool> virtual-mode: true;
    in-out property <float> left-x: 0;
    in-out property <float> left-y: 0;
    in-out property <float> right-x: 0;
    in-out property <float> right-y: 0;
    in-out property <bool> a-down: false;
    in-out property <bool> b-down: false;
    in-out property <bool> x-down: false;
    in-out property <bool> y-down: false;
    in-out property <bool> lb-down: false;
    in-out property <bool> rb-down: false;
    in-out property <bool> lt-down: false;
    in-out property <bool> rt-down: false;
    in-out property <bool> up-down: false;
    in-out property <bool> down-down: false;
    in-out property <bool> left-down: false;
    in-out property <bool> right-down: false;
    in-out property <bool> back-down: false;
    in-out property <bool> start-down: false;

    callback stick-drag(int, length, length, length);
    callback stick-release(int);
    callback control-pressed(string, bool);
    callback controller-selected(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            height: 44px;

            Text {
                text: "paws #" + root.display-id;
                color: #f2f5f8;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "Controller";
                color: #aab3bd;
                vertical-alignment: center;
            }

            ComboBox {
                model: root.controllers;
                current-index: root.controller-index;
                selected(value) => { root.controller-selected(self.current-index); }
                enabled: true;
                width: 280px;
                height: 34px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;

            body := Rectangle {
                width: min(parent.width, parent.height * 1.45);
                height: self.width / 1.45;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #262a2f;
                border-radius: self.height * 0.22;
                border-width: 3px;
                border-color: #3b424b;

                ControllerButton {
                    label: "LT";
                    down: root.lt-down;
                    pressed-changed(value) => { root.control-pressed("LT", value); }
                    x: body.width * 0.08;
                    y: body.height * 0.04;
                    width: body.width * 0.16;
                    height: body.height * 0.09;
                }
                ControllerButton {
                    label: "RT";
                    down: root.rt-down;
                    pressed-changed(value) => { root.control-pressed("RT", value); }
                    x: body.width * 0.76;
                    y: body.height * 0.04;
                    width: body.width * 0.16;
                    height: body.height * 0.09;
                }
                ControllerButton {
                    label: "LB";
                    down: root.lb-down;
                    pressed-changed(value) => { root.control-pressed("LB", value); }
                    x: body.width * 0.16;
                    y: body.height * 0.16;
                    width: body.width * 0.14;
                    height: body.height * 0.075;
                }
                ControllerButton {
                    label: "RB";
                    down: root.rb-down;
                    pressed-changed(value) => { root.control-pressed("RB", value); }
                    x: body.width * 0.70;
                    y: body.height * 0.16;
                    width: body.width * 0.14;
                    height: body.height * 0.075;
                }

                Stick {
                    width: body.width * 0.22;
                    height: self.width;
                    x: body.width * 0.13;
                    y: body.height * 0.36;
                    value-x: root.left-x;
                    value-y: root.left-y;
                    interactive: root.virtual-mode;
                    drag(dx, dy, radius) => { root.stick-drag(0, dx, dy, radius); }
                    released => { root.stick-release(0); }
                }

                Stick {
                    width: body.width * 0.22;
                    height: self.width;
                    x: body.width * 0.65;
                    y: body.height * 0.56;
                    value-x: root.right-x;
                    value-y: root.right-y;
                    interactive: root.virtual-mode;
                    drag(dx, dy, radius) => { root.stick-drag(1, dx, dy, radius); }
                    released => { root.stick-release(1); }
                }

                // D-pad: up, down, left, right around a center point.
                ControllerButton {
                    label: "U";
                    down: root.up-down;
                    pressed-changed(value) => { root.control-pressed("Up", value); }
                    width: body.width * 0.072;
                    height: self.width;
                    x: body.width * 0.22 - self.width / 2;
                    y: body.height * 0.80 - self.height * 1.5;
                }
                ControllerButton {
                    label: "D";
                    down: root.down-down;
                    pressed-changed(value) => { root.control-pressed("Down", value); }
                    width: body.width * 0.072;
                    height: self.width;
                    x: body.width * 0.22 - self.width / 2;
                    y: body.height * 0.80 + self.height * 0.5;
                }
                ControllerButton {
                    label: "L";
                    down: root.left-down;
                    pressed-changed(value) => { root.control-pressed("Left", value); }
                    width: body.width * 0.072;
                    height: self.width;
                    x: body.width * 0.22 - self.width * 1.5;
                    y: body.height * 0.80 - self.height / 2;
                }
                ControllerButton {
                    label: "R";
                    down: root.right-down;
                    pressed-changed(value) => { root.control-pressed("Right", value); }
                    width: body.width * 0.072;
                    height: self.width;
                    x: body.width * 0.22 + self.width * 0.5;
                    y: body.height * 0.80 - self.height / 2;
                }

                // Face buttons in a diamond.
                ControllerButton {
                    label: "Y";
                    down: root.y-down;
                    pressed-changed(value) => { root.control-pressed("Y", value); }
                    width: body.width * 0.075;
                    height: self.width;
                    x: body.width * 0.79 - self.width / 2;
                    y: body.height * 0.40 - self.height * 1.2;
                }
                ControllerButton {
                    label: "A";
                    down: root.a-down;
                    pressed-changed(value) => { root.control-pressed("A", value); }
                    width: body.width * 0.075;
                    height: self.width;
                    x: body.width * 0.79 - self.width / 2;
                    y: body.height * 0.40 + self.height * 0.2;
                }
                ControllerButton {
                    label: "X";
                    down: root.x-down;
                    pressed-changed(value) => { root.control-pressed("X", value); }
                    width: body.width * 0.075;
                    height: self.width;
                    x: body.width * 0.79 - self.width * 1.2;
                    y: body.height * 0.40 - self.height / 2;
                }
                ControllerButton {
                    label: "B";
                    down: root.b-down;
                    pressed-changed(value) => { root.control-pressed("B", value); }
                    width: body.width * 0.075;
                    height: self.width;
                    x: body.width * 0.79 + self.width * 0.2;
                    y: body.height * 0.40 - self.height / 2;
                }

                ControllerButton {
                    label: "Back";
                    down: root.back-down;
                    pressed-changed(value) => { root.control-pressed("Back", value); }
                    width: body.width * 0.085;
                    height: body.height * 0.045;
                    x: body.width * 0.45 - self.width / 2;
                    y: body.height * 0.47;
                }
                ControllerButton {
                    label: "Start";
                    down: root.start-down;
                    pressed-changed(value) => { root.control-pressed("Start", value); }
                    width: body.width * 0.085;
                    height: body.height * 0.045;
                    x: body.width * 0.55 - self.width / 2;
                    y: body.height * 0.47;
                }
            }
        }

        Text {
            text: root.virtual-mode
                ? "Virtual mode: use the mouse or select a connected controller."
                : "Controller mode: the window mirrors the selected controller.";
            color: #858e98;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
