#include "math.idl"
#include "format_manager.idl"

module hello_world {
  struct HelloWorldTopic {
    string greeting;
    math::Quaternion attitude;
  };
  struct HelloWorldViewTopic {
    unsigned long display_id;
    string greeting;
    math::Quaternion attitude;
    boolean valid;
    long mode;
    boolean arcball;
    math::Vector3 light;
    math::Color color;
    double hue;
    double saturation;
    double value;
    long overlay;
  };
  struct HelloWorldInputTopic {
    unsigned long display_id;
    long action;
    double x;
    double y;
    double z;
    boolean pressed;
  };
  struct HelloWorldCtlTopic {
    unsigned long display_id;
    long action;
    double x;
    double y;
    double z;
    boolean pressed;
  };
};
